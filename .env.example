# Server-only secrets. Never put values in NEXT_PUBLIC_*, browser JS, source control, or chat.
# Demo works without any keys. Defaults do not make network payment calls.
PAYPAL_SANDBOX_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox captures must match fixture totals in USD; this map never accepts a live endpoint.
PAYPAL_SANDBOX_CAPTURE_MAP={"EX-1042":"YOUR_SANDBOX_CAPTURE_ID"}
# Optional explanation-only AI. Policy and amounts are always deterministic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
